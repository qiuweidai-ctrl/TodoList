# 本地开发：复制成 backend/.env 并按需修改（该文件不会提交到 Git）

# 生产环境必须换成随机值：
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-dev-only-key-please-change-before-deploying

# 本地调试保持 True；部署时改成 False
DJANGO_DEBUG=True

# 允许访问的域名，逗号分隔
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 前端地址（CORS 白名单）
DJANGO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 需要信任的 CSRF 来源（一般只有前后端同域部署时才需要）
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
